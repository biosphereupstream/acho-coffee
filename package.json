{
  "name": "acho-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@acho/frontend",
    "build": "npm run build --workspace=@acho/frontend",
    "start": "npm run start --workspace=@acho/frontend",
    "lint": "npm run lint --workspace=@acho/frontend",
    "typecheck": "npm run typecheck --workspace=@acho/frontend",
    "validate": "npm run validate --workspace=@acho/frontend",
    "ship": "node scripts/ship.js",
    "backend:build": "cd backend && (go build -v ./cmd/server 2>nul || \"%ProgramFiles%\\Go\\bin\\go\" build -v ./cmd/server)",
    "backend:start": "cd backend && (go run ./cmd/server 2>nul || \"%ProgramFiles%\\Go\\bin\\go\" run ./cmd/server)",
    "backend:test": "cd backend && (go test ./... 2>nul || \"%ProgramFiles%\\Go\\bin\\go\" test ./...)",
    "db:generate": "npm run db:generate --workspace=@acho/frontend",
    "db:migrate": "npm run db:migrate --workspace=@acho/frontend",
    "db:push": "npm run db:push --workspace=@acho/frontend",
    "db:studio": "npm run db:studio --workspace=@acho/frontend"
  }
}
