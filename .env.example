# ===== Umum =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Supabase (Auth: email/password + Google OAuth) =====
# Supabase Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # format baru (atau NEXT_PUBLIC_SUPABASE_ANON_KEY legacy)
# Google OAuth diaktifkan di Supabase Dashboard > Authentication > Providers > Google
# (callback URL: {SITE_URL}/auth/callback)
SUPABASE_SERVICE_ROLE_KEY=...   # opsional, untuk admin (secret key)

# ===== Database Postgres (Supabase: tombol Connect > Connection string) =====
# Runtime aplikasi (Vercel/serverless): TRANSACTION POOLER port 6543
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Opsional untuk migrasi (drizzle-kit push): DIRECT connection port 5432
DIRECT_DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ===== Resend (email transaksional) =====
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=ACHO Coffee <hello@acho.coffee>

# ===== Doku / Jokul Payment (sandbox dulu) =====
DOKU_ENV=sandbox            # sandbox | production
DOKU_CLIENT_ID=BRN-xxxx-xxxx
DOKU_SHARED_KEY=SK-xxxx     # dipakai untuk signature HMAC-SHA256
DOKU_API_KEY=doku_key_xxxx  # opsional, untuk endpoint Doku lain
DOKU_MERCHANT_NAME=ACHO Coffee
# DOKU_DEMO_FALLBACK=1       # hanya untuk dev lokal bila sandbox Doku tak terjangkau — JANGAN aktifkan di produksi
# ACHO_DATA_DIR=              # opsional: path absolut store demo (default: <project>/.data)

# ===== Biteship (kurir & tracing) =====
BITESHIP_API_KEY=biteship_test.eyJ...
BITESHIP_ORIGIN_AREA_ID=IDJKTBES0000   # area id asal (cek GET /v1/maps/areas)
BITESHIP_ORIGIN_ADDRESS=Jl. Kopi No. 1, Bandung
BITESHIP_WEBHOOK_SECRET=    # opsional

# ===== Cloudflare R2 (object storage) =====
R2_ACCOUNT_ID=xxxx
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET=acho-coffee
R2_PUBLIC_URL=https://cdn.acho.coffee   # atau https://pub-xxx.r2.dev

# ===== Admin (halaman /admin) =====
ADMIN_EMAILS=owner@acho.coffee,admin@acho.coffee
